{
  "name": "gabriel-carvalho-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/projects.test.ts",
    "format": "prettier --write app components data lib types tests scripts package.json tsconfig.json postcss.config.mjs eslint.config.mjs next.config.ts README.md DESIGN.md PRODUCT.md",
    "test:ui": "node scripts/verify-ui.mjs",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "lucide-react": "1.42.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
